# Copy to .env and replace every value before starting docker compose.
SSE_DB_PASSWORD=replace-with-a-long-random-database-password
SSE_JWT_SECRET=replace-with-at-least-32-random-characters
SSE_CORS_ALLOWED_ORIGINS=https://school.example.com
SSE_SEED_ENABLED=false
SSE_BACKEND_PORT=4000
SSE_PAYMENT_MODE=vietqr
SSE_VIETQR_BANK_ID=MB
SSE_VIETQR_ACCOUNT_NO=0123456789
SSE_VIETQR_ACCOUNT_NAME=TRUONG HOC SO
SSE_VIETQR_TEMPLATE=compact2
SSE_MAIL_ENABLED=false
SSE_MAIL_HOST=smtp.example.com
SSE_MAIL_PORT=587
SSE_MAIL_USERNAME=
SSE_MAIL_PASSWORD=
SSE_FIREBASE_ENABLED=false
SSE_FIREBASE_PROJECT_ID=
SSE_FIREBASE_CREDENTIALS_PATH=
SSE_FIREBASE_CREDENTIALS_BASE64=
SSE_MAIL_FROM=no-reply@example.com
SSE_PASSWORD_RESET_URL=https://school.example.com/#/dat-lai-mat-khau
SSE_ACCOUNT_ACTIVATION_URL=https://school.example.com/#/kich-hoat-tai-khoan
