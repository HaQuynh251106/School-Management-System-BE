# Copy to .env and replace every value before starting docker compose.
SSE_DB_PASSWORD=replace-with-a-long-random-database-password
SSE_JWT_SECRET=replace-with-at-least-32-random-characters
SSE_CORS_ALLOWED_ORIGINS=https://school.example.com
SSE_SEED_ENABLED=false
SSE_BACKEND_PORT=4000
SSE_PAYMENT_MODE=disabled
SSE_PAYMENT_CALLBACK_SECRET=replace-with-at-least-32-random-characters
SSE_VNPAY_TMN_CODE=
SSE_VNPAY_HASH_SECRET=
SSE_VNPAY_PAYMENT_URL=https://pay.vnpay.vn/vpcpay.html
SSE_VNPAY_RETURN_URL=https://school.example.com/payment-result
SSE_MAIL_ENABLED=false
SSE_MAIL_HOST=smtp.example.com
SSE_MAIL_PORT=587
SSE_MAIL_USERNAME=
SSE_MAIL_PASSWORD=
SSE_MAIL_FROM=no-reply@example.com
SSE_PASSWORD_RESET_URL=https://school.example.com/reset-password
