# Sao chép thành .env.local trước khi chạy PostgreSQL cục bộ.
SSE_DB_URL=jdbc:postgresql://127.0.0.1:5432/sse_db
SSE_DB_USER=sse
SSE_DB_PASSWORD=replace-with-a-strong-local-password
SSE_JWT_SECRET=replace-with-at-least-32-random-characters
SSE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SSE_SEED_ENABLED=false
SSE_PAYMENT_MODE=sandbox
SSE_PAYMENT_CALLBACK_SECRET=replace-with-at-least-32-random-characters
SSE_STORAGE_PATH=./data/uploads
