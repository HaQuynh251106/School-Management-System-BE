# Sao chép thành .env.local trước khi chạy PostgreSQL cục bộ.
SSE_DB_URL=jdbc:postgresql://127.0.0.1:5432/sse_db
SSE_DB_USER=sse
SSE_DB_PASSWORD=replace-with-a-strong-local-password
SSE_JWT_SECRET=replace-with-at-least-32-random-characters
SSE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SSE_SEED_ENABLED=false
# VietQR tạo mã chuyển khoản; Admin xác nhận sau khi đối soát giao dịch ngân hàng.
SSE_PAYMENT_MODE=vietqr
SSE_VIETQR_BANK_ID=MB
SSE_VIETQR_ACCOUNT_NO=0123456789
SSE_VIETQR_ACCOUNT_NAME=TRUONG HOC SO
SSE_VIETQR_TEMPLATE=compact2
# Bật và điền SMTP để gửi biên nhận thanh toán tới email thật của phụ huynh.
SSE_MAIL_ENABLED=false
SSE_MAIL_HOST=smtp.gmail.com
SSE_MAIL_PORT=587
SSE_MAIL_USERNAME=
SSE_MAIL_PASSWORD=
SSE_FIREBASE_ENABLED=false
SSE_FIREBASE_PROJECT_ID=
SSE_FIREBASE_CREDENTIALS_PATH=
SSE_FIREBASE_CREDENTIALS_BASE64=
SSE_MAIL_FROM=
SSE_ACCOUNT_ACTIVATION_URL=http://localhost:5173/activate-account
SSE_MAIL_AUTH=true
SSE_MAIL_STARTTLS=true
SSE_STORAGE_PATH=./data/uploads
