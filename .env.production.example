# Image được phát hành tự động lên GitHub Container Registry.
SSE_BACKEND_IMAGE=ghcr.io/haquynh251106/school-management-system-be:latest
SSE_WEB_IMAGE=ghcr.io/haquynh251106/school-management-system-web-fe:latest

SSE_WEB_PORT=80
SSE_BACKEND_PORT=4000
SSE_DB_NAME=sse_db
SSE_DB_USER=sse
SSE_DB_PASSWORD=replace-with-a-long-random-password
SSE_JWT_SECRET=replace-with-at-least-32-random-characters
SSE_CORS_ALLOWED_ORIGINS=https://school.example.com
SSE_PASSWORD_RESET_URL=https://school.example.com/reset-password

SSE_PAYMENT_MODE=vietqr
SSE_VIETQR_BANK_ID=970407
SSE_VIETQR_ACCOUNT_NO=replace-with-beneficiary-account-number
SSE_VIETQR_ACCOUNT_NAME=replace-with-beneficiary-name
SSE_VIETQR_TEMPLATE=compact2

SSE_MAIL_ENABLED=false
SSE_MAIL_HOST=smtp.example.com
SSE_MAIL_PORT=587
SSE_MAIL_USERNAME=
SSE_MAIL_PASSWORD=
SSE_MAIL_FROM=no-reply@school.example.com

SSE_FIREBASE_ENABLED=false
SSE_FIREBASE_PROJECT_ID=
SSE_FIREBASE_CREDENTIALS_BASE64=

# Vận hành và quan sát
SSE_GRAFANA_ADMIN_USER=admin
SSE_GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
SSE_BACKUP_INTERVAL_SECONDS=86400
SSE_BACKUP_RETENTION_DAYS=30
